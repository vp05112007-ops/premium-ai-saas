{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/templates/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/templates/index.html"
    },
    {
      "source": "/templates/:path*",
      "destination": "/templates/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/templates/auth/:path*"
    },
    {
      "source": "/public/:path*",
      "destination": "/templates/public/:path*"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/templates/dashboard/:path*"
    },
    {
      "source": "/profile.html",
      "destination": "/templates/profile.html"
    },
    {
      "source": "/settings.html",
      "destination": "/templates/settings.html"
    },
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    }
  ]
}